# Copy to .env (untracked) and fill in from YOUR Supabase project:
#   Dashboard -> Project Settings -> API  (Project URL, and the publishable key; legacy "anon" key also works)
# Never put a service_role / sb_secret_ key in this file or in any VITE_* variable.

# Browser (Vite exposes VITE_* variables to the client)
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# Server functions (SSR / chat). Same two values.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# AI chat and "generate my plan" (Lovable AI Gateway only; leave unset to run without AI)
# LOVABLE_API_KEY=
