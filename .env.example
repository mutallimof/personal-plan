# Copy to .env (untracked) and fill in from YOUR Supabase project:
#   Dashboard -> Project Settings -> API  (Project URL, and the publishable key; legacy "anon" key also works)
# Never put a service_role / sb_secret_ key in this file or in any VITE_* variable.

# Browser (Vite exposes VITE_* variables to the client)
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# Server functions (SSR / chat). Same two values.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# AI chat and "Generate my plan". SERVER ONLY: never give these a VITE_ prefix.
# Leave AI_API_KEY unset to run without AI.
#
# Provider: gemini (default) | openai-compatible | anthropic (not implemented yet)
# AI_PROVIDER=gemini
# Base URL. Optional for gemini (defaults to Google's OpenAI-compatible endpoint);
# required for openai-compatible, e.g. an OpenAI, OpenRouter or Ollama /v1 URL.
# AI_BASE_URL=
# Model id. Optional for gemini (defaults to a free-tier Flash model); required otherwise.
# AI_MODEL=
# API key from your provider (Google AI Studio for gemini).
# AI_API_KEY=
